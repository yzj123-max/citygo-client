<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.logindemo.mapper.AttractionMapper">

    <select id="getOotdDescById" resultType="java.lang.String">
        SELECT ootd_desc
        FROM attractions
        WHERE id = #{id}
    </select>

</mapper>