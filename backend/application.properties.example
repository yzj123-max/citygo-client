spring.application.name=login-demo
server.address=0.0.0.0
server.port=8080
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/citygo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.database=0
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=20MB
mybatis-plus.mapper-locations=classpath*:mapper/*.xml
mybatis-plus.configuration.map-underscore-to-camel-case=true
agent.ark-api-key=${ARK_API_KEY:}
agent.endpoint=${ARK_ENDPOINT:}
agent.base-url=${ARK_BASE_URL:https://ark.cn-beijing.volces.com/api/v3}
ai.agent.ark-api-key=${ARK_API_KEY:}
ai.agent.endpoint=${ARK_ENDPOINT:}
ai.agent.base-url=${ARK_BASE_URL:https://ark.cn-beijing.volces.com/api/v3}
volc.tos.accessKeyId=${TOS_ACCESS_KEY_ID:}
volc.tos.secretAccessKey=${TOS_SECRET_ACCESS_KEY:}
volc.tos.bucketName=${TOS_BUCKET_NAME:}
volc.tos.endpoint=${TOS_ENDPOINT:}
volc.tos.region=${TOS_REGION:}
volc.tos.presignExpireSeconds=1800
amap.poi.web-key=${AMAP_WEB_KEY:}
attractions.admin-user-ids=${ATTRACTIONS_ADMIN_USER_IDS:}
